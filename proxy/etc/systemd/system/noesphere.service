[Unit]
Description=Noesphere gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=noesphere
Group=noesphere
WorkingDirectory=/opt/noesphere

Environment=DB_FILE=/opt/noesphere/noesphere.db
Environment=PORT=8787
Environment=WORKERS=1
# ADMIN_KEY открывает /admin?key=... При развёртывании на новом хосте
# сгенерируйте свой: openssl rand -hex 16
Environment=ADMIN_KEY=dudo_2026
# SIGNATURE_SECRET подписывает блоки thinking и проверяет подписи, пришедшие от
# клиента. Смена значения не ломает уже выданные ответы, но старые подписи
# перестанут сходиться.
Environment=SIGNATURE_SECRET=41142a1039e754155de2afca7a2833cc64462018df28ebf257ac37bbbd0408cf
# Имитация провайдера по owned_by маппинга: anthropic / openai
Environment=PROVIDER_IMITATION=1
# Выдавать блок рассуждения (thinking) в ответе
Environment=EMIT_REDACTED_THINKING=1
# Форма блока: thinking (как оригинал при display=omitted) или redacted
Environment=THINKING_BLOCK_STYLE=thinking
# Подменять названия брендов в ответах на своё. По умолчанию выключено: если у
# апстрима свой системный промт, подмена ломает его.
Environment=BRAND_SCRUB=0
Environment=PDF_MODE=auto
Environment=PDF_IMAGE_MAX_PAGES=8
Environment=HTTPX_READ_TIMEOUT=1800

ExecStart=/opt/noesphere/venv/bin/python /opt/noesphere/proxy.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
